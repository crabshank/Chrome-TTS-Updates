{
  "manifest_version": 3,
  "name": "TTS Updates",
  "version": "2026.11",
  "minimum_chrome_version": "135",
  "permissions": [
    "storage",
	"unlimitedStorage",
    "userScripts",
	"offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
   "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "options_page": "options.html",
  "icons": {
        "128": "icon.png"
  }
}